{
  "name": "sdjfam-chat",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:sidecar": "bun build ./tiktok-chat-helper.mjs --compile --target=bun-windows-x64 --outfile ./src-tauri/binaries/tiktok-chat-helper-x86_64-pc-windows-msvc.exe",
    "dev:tauri": "npm run build:sidecar && npm run dev",
    "test:live-stats": "node --test tests/live-stats.test.cjs tests/tiktok-sidecar.test.mjs tests/tiktok-hook.test.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tiktok-live-connector": "^2.4.4",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/tmi.js": "^1.8.6",
    "@vitejs/plugin-react": "^4.6.0",
    "bun": "^1.4.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
