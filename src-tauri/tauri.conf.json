{
  "productName": "SDJFAM Chat",
  "version": "0.1.6",
  "identifier": "com.sdjde.sdjfam-chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SDJFAM Chat",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/tiktok-chat-helper"
   ],
    "resources": [
      "../youtube-oauth.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMUM2NDVGOTNGMjlFNTAKUldSUW52S1RYMlFjTHltSUR3NGVBd2kxNXZNQUxCUElWU2IzdEtGcm55NTNaNHg4VGpNdXRqVVQK",
      "endpoints": [
        "https://github.com/sdjfam/sdjfam-chat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}